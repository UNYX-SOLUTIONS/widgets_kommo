# =========================================================
# WIDGETS KOMMO
# Plantilla de entorno de producción (OPCIONAL)
# =========================================================

# Este proyecto NO tiene secretos en el HTML de los widgets. El backend
# del widget «Verificar Cliente» sí tiene secretos (Secret key de la
# integración de Kommo): esos viven en `backend/.env`, que NO se versiona.
# Ver `backend/.env.example`.
#
# Si NO creas .env.production, se usan estos valores por defecto
# (definidos en docker-compose.yml):
#   WIDGETS_DOMAIN          = widgets.unyxsolutions.com
#   WIDGETS_API_DOMAIN      = api.widgets.unyxsolutions.com
#   WIDGETS_HTTP_PORT       = 8081
#   WIDGETS_API_HTTP_PORT   = 8082
#   TRAEFIK_NETWORK         = unyx-widgets-front
#
# Para cambiar algo:  cp .env.example .env.production  y edítalo.
# Nunca subir .env.production a Git.

# =========================================================
# DOMINIOS
# widgets.… sirve los HTML estáticos.
# api.widgets.… sirve el backend del widget privado.
# Ambos registros DNS deben apuntar al VPS y ambos usan Let's Encrypt,
# así que créalos ANTES de desplegar.
# =========================================================

WIDGETS_DOMAIN=widgets.unyxsolutions.com
WIDGETS_API_DOMAIN=api.widgets.unyxsolutions.com

# =========================================================
# PUERTOS LOCALES
# Solo se publican en 127.0.0.1 del VPS (Traefik hace el resto).
# Cambiar si el puerto ya está ocupado.
# =========================================================

WIDGETS_HTTP_PORT=8081
WIDGETS_API_HTTP_PORT=8082

# =========================================================
# TRAEFIK
# Nombre de la red Docker externa que comparte con Traefik
# y nombre del contenedor de Traefik (para conectarlo si hace falta).
# =========================================================

TRAEFIK_NETWORK=unyx-widgets-front
TRAEFIK_CONTAINER=traefik
