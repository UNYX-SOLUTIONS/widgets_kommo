# =========================================================
# WIDGETS KOMMO
# Plantilla de entorno de producción
# =========================================================

# IMPORTANTE:
# Copiar este archivo como .env.production en el VPS.
# Nunca subir .env.production a Git.

# =========================================================
# DOMINIO
# El dominio donde se publican los widgets.
# El certificado HTTPS lo emite Traefik + Let's Encrypt,
# así que el registro DNS debe apuntar al VPS ANTES de desplegar.
# =========================================================

WIDGETS_DOMAIN=widgets.unyxsolutions.com

# =========================================================
# PUERTO LOCAL
# Solo se publica en 127.0.0.1 del VPS (Traefik hace el resto).
# Cambiar si el puerto ya está ocupado.
# =========================================================

WIDGETS_HTTP_PORT=8081

# =========================================================
# TRAEFIK
# Nombre de la red Docker externa que comparte con Traefik
# y nombre del contenedor de Traefik (para conectarlo si hace falta).
# =========================================================

TRAEFIK_NETWORK=unyx-widgets-front
TRAEFIK_CONTAINER=traefik

TZ=America/Guayaquil
