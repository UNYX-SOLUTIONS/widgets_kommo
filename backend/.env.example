# =========================================================
# BACKEND UNYX - Widget Kommo «Verificar Cliente»
# Copie este archivo a .env y complete los valores.
# NUNCA suba el archivo .env con secretos a Git.
# =========================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =========================================================
# CREDENCIALES DE LA INTEGRACIÓN PRIVADA DE KOMMO
# Settings -> Integrations -> Create Integration
# "Keys and scopes": Integration ID y Secret key.
# El Secret key solo se muestra una vez: guárdelo antes de salir.
# =========================================================

KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=

# Subdominio de la cuenta (https://SUBDOMAIN.kommo.com).
# El backend rechaza cualquier otra cuenta.
KOMMO_SUBDOMAIN=

# Debe coincidir EXACTAMENTE con el Redirect URI configurado en Kommo.
KOMMO_REDIRECT_URI=https://api.widgets.unyxsolutions.com/api/kommo/oauth/callback

# =========================================================
# SECRETOS PROPIOS
# Genere valores aleatorios: openssl rand -hex 32
# SESSION_SECRET firma la sesión del widget y el state de OAuth.
# CHECK_SECRET firma el checkId de un uso. Si no se define, se
# usa SESSION_SECRET.
# =========================================================

SESSION_SECRET=
CHECK_SECRET=

SESSION_TTL_SECONDS=3600
CHECK_TTL_SECONDS=300

# =========================================================
# ALMACENAMIENTO DE TOKENS
# Ruta del archivo JSON con los tokens OAuth por asesor (modo 600).
# Debe estar en un volumen persistente.
# =========================================================

TOKEN_FILE=/app/data/tokens.json

# =========================================================
# RED
# Orígenes permitidos. Kommo proxya las llamadas, así que el
# Origin llega como https://SUBDOMAIN.kommo.com.
# =========================================================

CORS_ORIGINS=https://*.kommo.com
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
KOMMO_API_TIMEOUT_MS=15000

# =========================================================
# REGLA DE "LEAD ACTIVO"
# Un lead está cerrado si su etapa coincide con CLOSED_STAGE_PATTERN
# o si el orden de la etapa (sort) es >= CLOSED_STAGE_SORT_MIN.
# Kommo marca las etapas de cierre con sort 10000 en adelante.
# =========================================================

CLOSED_STAGE_SORT_MIN=10000
CLOSED_STAGE_PATTERN=(cerrad|closed|ganad|perdid|won|lost)

# =========================================================
# CREACIÓN DEL LEAD
# Pipeline/etapa destino. Si se dejan en 0, Kommo usa el primer
# pipeline y la primera etapa.
# LEAD_SOURCE_EXTERNAL_ID: external_id de una fuente creada con la
# API de Sources del widget.
# LEAD_NAME_TEMPLATE admite {name} y {phone}.
# =========================================================

LEAD_PIPELINE_ID=0
LEAD_STATUS_ID=0
LEAD_SOURCE_EXTERNAL_ID=
LEAD_NAME_TEMPLATE={name} · {phone}
CONTACT_NAME_FALLBACK={phone}
