    {
      "parameters": {
        "jsCode": "const PIPELINE_VENTAS = 12677012;\nconst PIPELINE_RECURRENTES = 12676956;\nconst STAGE_WON_ID = 142;\nconst STAGE_LOST_ID = 143;\nconst FIELD_COTIZACION_ID = 1046555;\nconst leads = items.flatMap(i => i.json._embedded?.leads ?? []);\nfunction tieneCotizacion(lead) { const field = lead.custom_fields_values?.find(f => f.field_id === FIELD_COTIZACION_ID); if (!field?.values?.length) return false; const valor = field.values[0].value; return valor !== null && valor !== undefined && String(valor).trim() !== ''; }\nlet countWon = 0; let countLost = 0;\nfor (const lead of leads) { if (lead.pipeline_id !== PIPELINE_VENTAS && lead.pipeline_id !== PIPELINE_RECURRENTES) continue; if (!tieneCotizacion(lead)) continue; if (lead.status_id === STAGE_WON_ID) countWon++; else if (lead.status_id === STAGE_LOST_ID) countLost++; }\nconst totalCerrados = countWon + countLost;\nconst percentage = totalCerrados > 0 ? ((countWon / totalCerrados) * 100).toFixed(1) : '0.0';\nreturn [{ json: { text_main: String(countWon) + ' de ' + String(totalCerrados), text_sub: String(percentage) + '%', raw_won: countWon, raw_lost: countLost, raw_total: totalCerrados } }];"
